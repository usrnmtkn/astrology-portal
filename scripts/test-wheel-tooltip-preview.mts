import assert from 'node:assert/strict';
import {wheelTooltipDraftPreview,wheelTooltipTemplates} from '../apps/web/src/content/wheelTooltipCopy';
import {wheelTooltipPreviewCharts} from '../apps/admin/src/wheelTooltipPreviewCharts';
const base=wheelTooltipTemplates();
const draft=wheelTooltipDraftPreview(base,'cms/wheel-tooltip/variables/owner-you-title','My unsaved chart');
assert.deepEqual(draft.errors,[]);
assert.equal(draft.templates!('variables/owner-you-title'),'My unsaved chart');
assert.equal(base('variables/owner-you-title'),'Your');
assert.equal(draft.templates!('variables/owner-you-body'),base('variables/owner-you-body'));
assert.equal(wheelTooltipDraftPreview(base,'cms/wheel-tooltip/variables/owner-you-title','{{unsupported}}').templates,null);
assert.equal(wheelTooltipDraftPreview(base,'unknown','hello').templates,null);
assert.equal(wheelTooltipDraftPreview(base,'cms/wheel-tooltip/variables/house-ordinal','Fixed house').templates,null);
const birth={birthDate:'1990-01-01',birthTime:'12:00',birthLocation:{label:'Synthetic City',latitude:0,longitude:0,timeZone:'UTC'}};
const friend={id:'friend',owner_user_id:'owner',display_name:'Alex',birth_date:'1996-07-02',birth_time:null,birth_time_unknown:true,birth_place:'Synthetic City',birth_latitude:20,birth_longitude:10,birth_timezone:'UTC'};
const profile={version:1,profile:{name:'Casey',charts:[birth]}};
const before=JSON.stringify([profile,friend]);
const charts=wheelTooltipPreviewCharts(profile,[friend,{...friend,id:'other-owner',owner_user_id:'another'}],'owner');
assert.equal(charts.length,2);assert.equal(charts[0].subject.datetime.timeKnown,true);
assert.equal(charts[1].subject.datetime.timeKnown,false);assert.equal(charts[1].subject.datetime.time,'12:00');
assert.equal(JSON.stringify([profile,friend]),before);
assert.deepEqual(wheelTooltipPreviewCharts(null,[],'owner'),[]);
assert.deepEqual(wheelTooltipPreviewCharts({charts:[{...birth,birthDate:'1990-02-31'}]},[],'owner'),[]);
assert.deepEqual(wheelTooltipPreviewCharts({charts:[{...birth,birthLocation:{...birth.birthLocation,timeZone:'Not/AZone'}}]},[],'owner'),[]);
assert.deepEqual(wheelTooltipPreviewCharts({charts:[{...birth,birthLocation:{...birth.birthLocation,latitude:Infinity}}]},[],'owner'),[]);
console.log('Unpublished wheel overlay: exact-source isolation, invalid edits hidden, validated owned birth inputs, unknown time and immutable profiles passed.');
