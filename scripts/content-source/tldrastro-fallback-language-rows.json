{
  "schema": "tldrastro-admin-content-v1",
  "note": "Fallback VOCAB as editable dashboard rows, keyed to the EXACT template variables your existing dashboard templates already use. No new template strings — your templates stay the templates; these rows fill their slots. Single editable source: the admin. The emergency composer + planetTopicVocabulary must read these instead of any hardcoded bank.",
  "variableMap": {
    "{{planetTopic}} / {{planetATopic}} / {{planetBTopic}} / {{transitPlanetTopic}}": "fallback-vocab/planet-topic/{planet}",
    "{{natalPointTopic}} (angle)": "fallback-vocab/angle-topic/{angle}",
    "{{planetACore}} / {{planetBCore}}": "fallback-vocab/planet-core/{planet}",
    "{{signStyle}} / {{signAStyle}} / {{signBStyle}}": "fallback-vocab/sign-style/{sign}",
    "{{signNeed}}": "fallback-vocab/sign-need/{sign}",
    "{{houseLifeArea}} / {{lifeAreaDescription}} / {{lifeArea}}": "fallback-vocab/house-life-area/{house}",
    "{{aspectVerb}}": "fallback-vocab/aspect-verb/{aspect}",
    "{{aspectFeel}}": "fallback-vocab/aspect-feel/{aspect}",
    "ruler logic": "fallback-vocab/sign-ruler/{sign}",
    "{{aspectAdj}}": "fallback-vocab/aspect-adj/{aspect}"
  },
  "compositionRules": {
    "namedFunctionRequired": "Always fill the topic slot from planetFunction / angleFunction (a named meaning). Never use generic placeholders like 'this part of them', 'how this part becomes active', or 'this placement'.",
    "bannedPhrases": [
      "this part of them",
      "this part of you",
      "how this part becomes active",
      "becomes active",
      "so the point is not generic",
      "is not generic",
      "material.",
      "working through",
      "the point is",
      "describes how",
      "this placement describes",
      "generic ascendant material",
      "carries that story further",
      "this placement becomes concrete",
      "becomes concrete through",
      "pulling sense of self toward",
      "points this house toward",
      "this is where",
      "builds identity",
      "how this part",
      "this part becomes"
    ],
    "noMetaCopy": "Never describe the astrology's own construction or reassure the reader it isn't generic. Say what the point means, then how the sign colors it, then where the house lands it.",
    "shape": "{Subject} {Point} is in {Sign}{ in the {House} house}. {pointFunction}, colored by {signTone}{, landing in {houseArea}}.",
    "rulershipMustExplain": "When a placement section follows a sign's ruling planet into another house, first state the rulership reason (\"{Sign} is ruled by {Ruler}\" / \"the Ascendant is {Sign}, so {Ruler} is the chart ruler\"), then give the ruler's placement. Never jump to the ruler's house without naming why. Use the signRuler map so the ruler is astrologically correct.",
    "grammar": {
      "article": "Use 'an' before a vowel sound, 'a' otherwise. Never 'a unconventional' / 'a inventive'.",
      "subjectVerb": "Match verb to subject: 'they build' (not 'they builds'), 'she builds'. Never emit 'they builds'.",
      "noDoubleArticle": "Do not prepend an article when the signTone slot is used in a template that already supplies one."
    },
    "singleSource": "This file is the ONLY source of emergency/fallback reader vocab. The app must not keep parallel hardcoded planet-meaning, sign-style, house-topic, or ruler-sentence banks. Any deterministic composer reads planetFunction / angleFunction / signTone / houseArea / signRuler / templates from here."
  },
