const created=await createMonthlyAspectPublicationFixture(m=>store.invoke(m.method,m.body,m.url));
assert.equal(created.status,200,JSON.stringify(created.payload));let row=created.payload.rows[0];
const edition=structuredClone(row.sections.horoscopeEdition);
edition.passages[0].body='You can keep your own wording — including its punctuation. This complete synthetic reading belongs to the author. There is time to consider the question carefully. A second paragraph does not need a model’s permission. The complete owner final sentence remains intact.';
const saved=await store.invoke('PATCH',{id:row.id,expectedUpdatedAt:row.updated_at,status:'DRAFT',body:horoscopeEditionBody(edition),sections:{horoscopeEdition:edition}});
assert.equal(saved.status,200,JSON.stringify(saved.payload));row=saved.payload.rows[0];
const check=await invokeHoroscopeWriting({action:'validate-publication',id:row.id,expectedUpdatedAt:row.updated_at});
assert.equal(check.status,200,JSON.stringify(check.payload));assert.equal(check.payload.publication.ready,true,JSON.stringify(check.payload));
const oldPath=await store.invoke('PATCH',{id:row.id,expectedUpdatedAt:row.updated_at,status:'LIVE',lane:'serving',reviewState:null});
assert.equal(oldPath.status,422,'Automatic publication without the explicit owner action retains its editorial policy.');
const published=await store.invoke('PATCH',{id:row.id,expectedUpdatedAt:row.updated_at,ownerAction:'publish-owner-content'});
assert.equal(published.status,200,JSON.stringify(published.payload));row=published.payload.rows[0];
assert.equal(row.status,'LIVE');assert.deepEqual(row.sections.horoscopeEdition,edition);assert(hasExactStudioOwnerApproval(row));
const before=structuredClone(row);
const invalid=structuredClone(edition);invalid.window.endsAt='2030-01-01T00:00:00.000Z';
const wrongWindow=await store.invoke('PATCH',{id:row.id,expectedUpdatedAt:row.updated_at,status:'DRAFT',body:horoscopeEditionBody(invalid),sections:{horoscopeEdition:invalid}});
assert.equal(wrongWindow.status,422);assert.deepEqual(store.rows.get(row.id),before);
for(const period of ['daily','weekly','monthly','seasonal']) {
  const prepared=await store.invoke('GET',undefined,`/api/admin/generated-content?horoscopeBrief=true&period=${period}&date=2026-11-05&timeZone=America%2FNew_York`);
  assert.equal(prepared.status,200,JSON.stringify(prepared.payload));
  const edition=emptyHoroscopeEdition(prepared.payload.brief.window);
  for(const passage of edition.passages) {passage.headline='Synthetic author reading';passage.body='The author keeps this wording — complete and uncompressed. This synthetic paragraph is the author’s final version. Another sentence develops the same observation. There is time to consider the answer carefully. The final sentence remains present.';}
  const created=await store.invoke('POST',{contentKey:horoscopeEditionKey(edition.window),surface:'sky',mode:'article',eventType:'horoscope-edition',provider:'manual-admin',status:'DRAFT',lane:'serving',headline:'Synthetic owner edition',summary:'',body:horoscopeEditionBody(edition),sections:{horoscopeEdition:edition},facts:{horoscopeBrief:{brief:prepared.payload.brief,signature:prepared.payload.signature}}});
  assert.equal(created.status,200,period+JSON.stringify(created.payload));const saved=created.payload.rows[0];
  const preflight=await invokeHoroscopeWriting({action:'validate-publication',id:saved.id,expectedUpdatedAt:saved.updated_at});
  assert.equal(preflight.status,200,period+JSON.stringify(preflight.payload));
  assert.equal(preflight.payload.publication.ready,true,period+' owner preflight must not treat prose register as an astronomical fact');
  const automatic=await store.invoke('PATCH',{id:saved.id,expectedUpdatedAt:saved.updated_at,status:'LIVE',lane:'serving',reviewState:null});
  assert.equal(automatic.status,422,period+' automatic publication retains editorial checks');
  const published=await store.invoke('PATCH',{id:saved.id,expectedUpdatedAt:saved.updated_at,ownerAction:'publish-owner-content'},'/api/admin/generated-content?horoscopeEditor=true');
  assert.equal(published.status,200,period+JSON.stringify(published.payload));
  assert.deepEqual(published.payload.rows[0].sections.horoscopeEdition,edition,period+' preserves all signs and complete exact author copy');
  assert(hasExactStudioOwnerApproval(published.payload.rows[0]),period);
  const publishedRow=published.payload.rows[0];
  const readerBefore=await readerRouteResponse('/api/content-reader',{method:'POST',body:JSON.stringify({ids:[publishedRow.id]})});
  assert.equal((await readerBefore.json()).rows[0].body,publishedRow.body,period+' published edition is reader-visible');
  const archiveBody={id:publishedRow.id,expectedUpdatedAt:publishedRow.updated_at,status:'ARCHIVED'};
  const storedBeforeArchive=structuredClone(store.rows.get(publishedRow.id));
  assert.equal((await store.invoke('PATCH',archiveBody,'/api/admin/generated-content?horoscopeEditor=true','wrong')).status,401);
  assert.equal((await store.invoke('PATCH',{...archiveBody,expectedUpdatedAt:saved.updated_at},'/api/admin/generated-content?horoscopeEditor=true')).status,409);
  assert.deepEqual(store.rows.get(publishedRow.id),storedBeforeArchive,period+' refused archive preserves the published row');
  const archived=await store.invoke('PATCH',archiveBody,'/api/admin/generated-content?horoscopeEditor=true');
  assert.equal(archived.status,200,period+JSON.stringify(archived.payload));
  const live=archived.payload.rows[0],invalid=structuredClone(edition);
  assert.equal(live.status,'ARCHIVED');
  assert.deepEqual(live.sections.horoscopeEdition,edition,period+' archival preserves every reading');
  assert.equal(live.body,publishedRow.body);
  for(const query of [{ids:[live.id]},{keys:[live.content_key]}]) {
    const readerAfter=await readerRouteResponse('/api/content-reader',{method:'POST',body:JSON.stringify(query)});
    assert.deepEqual((await readerAfter.json()).rows,[],period+' archived edition is excluded by ID and key');
  }
  const reopened=await store.invoke('GET',undefined,`/api/admin/generated-content?horoscopeEditions=true&horoscopeEditor=true&id=${live.id}`);
  assert.equal(reopened.status,200);assert.deepEqual(reopened.payload.rows[0].sections.horoscopeEdition,edition,period+' archived readings remain recoverable');
  invalid.passages[0].body+=' The exact clock time is 25:99.';
  const draft=await store.invoke('PATCH',{id:live.id,expectedUpdatedAt:live.updated_at,status:'DRAFT',body:horoscopeEditionBody(invalid),sections:{horoscopeEdition:invalid}});
  assert.equal(draft.status,200,period+JSON.stringify(draft.payload));
  const rejected=await store.invoke('PATCH',{id:live.id,expectedUpdatedAt:draft.payload.rows[0].updated_at,ownerAction:'publish-owner-content'});
  assert.equal(rejected.status,422,period+' explicit approval cannot bypass calculated timing boundaries');
  const empty=emptyHoroscopeEdition(edition.window);
  const emptySave=await store.invoke('PATCH',{id:live.id,expectedUpdatedAt:draft.payload.rows[0].updated_at,status:'DRAFT',body:horoscopeEditionBody(empty),sections:{horoscopeEdition:empty}});
  assert.equal(emptySave.status,200,period+JSON.stringify(emptySave.payload));
  const emptyArchive=await store.invoke('PATCH',{id:live.id,expectedUpdatedAt:emptySave.payload.rows[0].updated_at,status:'ARCHIVED'},'/api/admin/generated-content?horoscopeEditor=true');
  assert.equal(emptyArchive.status,200,period+' incomplete draft must have recoverable cleanup: '+JSON.stringify(emptyArchive.payload));
  assert.equal(emptyArchive.payload.rows[0].status,'ARCHIVED');assert.deepEqual(emptyArchive.payload.rows[0].sections.horoscopeEdition,empty);
}
console.log('PASS daily/weekly/monthly/seasonal horoscope owner publication: saved author punctuation, technical preflight, explicit exact approval, unchanged complete copy and signed window integrity. No paid calls.');
// Explicit owner override preserves a parser warning and exact reader copy.
let blocked=store.rows.get(created.payload.rows[0].id);
const blockedEdition=structuredClone(blocked.sections.horoscopeEdition);
blockedEdition.passages[0].body='Synthetic override opening. Mercury squares something in this sentence. Synthetic override final sentence.';
const blockedSave=await store.invoke('PATCH',{id:blocked.id,expectedUpdatedAt:blocked.updated_at,status:'DRAFT',body:horoscopeEditionBody(blockedEdition),sections:{horoscopeEdition:blockedEdition}});
assert.equal(blockedSave.status,200,JSON.stringify(blockedSave.payload));blocked=blockedSave.payload.rows[0];
const held=await invokeHoroscopeWriting({action:'validate-publication',id:blocked.id,expectedUpdatedAt:blocked.updated_at});
assert.equal(held.payload.publication.ready,false);assert.equal(held.payload.publication.canOverride,true);
assert.equal(blocked.event_type,'horoscope-edition-revision');
assert.deepEqual(store.rows.get(row.id),before,'Saving the override revision preserves the published edition');
const ordinary=await store.invoke('PATCH',{id:blocked.id,expectedUpdatedAt:blocked.updated_at,ownerAction:'publish-horoscope-edition-revision'});
assert.equal(ordinary.status,422);
const staleOverride=await store.invoke('PATCH',{id:blocked.id,expectedUpdatedAt:row.updated_at,ownerAction:'publish-horoscope-edition-revision',horoscopeValidationOverride:true});
assert.equal(staleOverride.status,409);
const overridden=await store.invoke('PATCH',{id:blocked.id,expectedUpdatedAt:blocked.updated_at,ownerAction:'publish-horoscope-edition-revision',horoscopeValidationOverride:true});
assert.equal(overridden.status,200,JSON.stringify(overridden.payload));
const finalRow=overridden.payload.rows[0];
const differentDecision=await store.invoke('GET',undefined,ownerPublicationStatusPath(blocked,'publish-horoscope-edition-revision'));
assert.equal(differentDecision.payload.found,false,'Recovery must bind the explicit fact-check override decision');
const recoveredOverride=await store.invoke('GET',undefined,ownerPublicationStatusPath(blocked,'publish-horoscope-edition-revision',true));
assert.equal(recoveredOverride.status,200);assert.equal(recoveredOverride.payload.rows[0].id,finalRow.id);
assert.equal(recoveredOverride.payload.rows[0].updated_at,finalRow.updated_at);
assert.deepEqual(finalRow.sections.horoscopeEdition,blockedEdition);
assert.equal(finalRow.source_snapshot.studioOwnerApproval.horoscopeValidationOverride.savedVersion,blocked.updated_at);
assert.deepEqual(finalRow.source_snapshot.studioOwnerApproval.horoscopeValidationOverride.issues,held.payload.publication.issues);
assert.equal(hasExactStudioOwnerApproval(finalRow),true);
const read=await readerRouteResponse('/api/content-reader',{method:'POST',body:JSON.stringify({ids:[finalRow.id]})});
assert.equal((await read.json()).rows[0].body,finalRow.body);
const tampered=structuredClone(finalRow);tampered.sections.horoscopeEdition.passages[0].body+=' Changed.';
assert.equal(hasExactStudioOwnerApproval(tampered),false);
const wrongWindowOverride=await store.invoke('PATCH',{id:finalRow.id,expectedUpdatedAt:finalRow.updated_at,status:'DRAFT',body:horoscopeEditionBody(invalid),sections:{horoscopeEdition:invalid}});
assert.equal(wrongWindowOverride.status,422);
console.log('PASS explicit override: ordinary publication blocked, version conflict refused, warnings audited, exact complete reader copy, and modified copy loses approval.');
await store.close();
