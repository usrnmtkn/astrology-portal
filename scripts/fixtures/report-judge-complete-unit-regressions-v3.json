      "startMarker": "## AUTUMN 2026: Desire and logistics meet each other",
      "endMarker": "## Sex and intimacy",
      "sourceSha256": "971dfcbd9ac80513dd7a6c2be44f6a5763e13660354c39df78560a27d4270024",
      "unitWindow": {
        "startsOn": "2026-09-22",
        "endsOn": "2026-12-21"
      },
      "factAudit": {
        "requiredFacts": [
          { "factType": "transit_arc", "factId": "saturn-sextile-ascendant", "transitPlanet": "Saturn", "natalPoint": "Ascendant", "natalHouse": 1, "aspect": "sextile", "passCount": 3, "passDates": ["2026-05-19", "2026-10-06", "2027-02-10"], "motions": ["direct", "retrograde", "direct"] },
          { "factType": "transit_arc", "factId": "jupiter-opposition-mars", "transitPlanet": "Jupiter", "natalPoint": "Mars", "natalHouse": 9, "aspect": "opposition", "passCount": 2, "passDates": ["2026-10-20", "2027-02-05"], "motions": ["direct", "retrograde"] }
        ],
        "claimSupport": [
          { "claim": "Oct 6 is Saturn's retrograde second sextile to the natal Ascendant, returning to the May first pass and followed by the Feb 10 final pass.", "supportingFactIds": ["saturn-sextile-ascendant"] },
          { "claim": "Oct 20 is Jupiter's first of two oppositions to natal Mars; the second pass returns Feb 5 while Jupiter is retrograde.", "supportingFactIds": ["jupiter-opposition-mars"] }
        ]
      },
      "attributionParagraphIndex": 10,
      "keyDatesParagraphIndex": 12,
      "movementApplicable": true,
      "expected": {
        "positiveMinimum": {
          "interpretive_movement": 3
        },
        "negativeMaximum": {
          "interpretive_movement": 2
        },
        "minimumPairDelta": {
          "interpretive_movement": 1
        }
      },
      "degradation": {
        "review_status": "needs_review",
        "ownerApproved": false,
        "promotionAuthorized": false,
        "method": "Replace the development paragraphs with transit-to-keyword-to-advice summaries while preserving the same paragraph count, chronology, named facts, attribution, key dates, and approximate unit length.",
        "replacements": [
          {
            "paragraphIndex": 1,
            "sourceSha256": "0c5d9cb12e7021146534f107c81de43b77d29ace7071cdb12ec96768dc24e165",
            "replacement": "Saturn makes its second sextile to your Ascendant on October 6. This transit brings structure, maturity, boundaries, and responsibility to relationships and daily arrangements. It asks you to build a more sustainable foundation."
          },
          {
            "paragraphIndex": 2,
            "sourceSha256": "7192ce5b72f779ccce36f67304b434be2f1a23977a68ece1c3c591addebd5f80",
            "replacement": "This is a time to review your boundaries and create a healthier relationship rhythm. Make sure the schedule supports every area of life. Communicate clearly, divide responsibilities fairly, and remain committed to balance when circumstances become demanding or another person has different expectations."
          },
          {
            "paragraphIndex": 3,
            "sourceSha256": "a7239eeaac0388ff59cfa78b86c843da82986749045b1fc3349231c976f0d0d8",
            "replacement": "You may need to balance connection with sleep, work, recovery, travel, and other responsibilities. Honor each person's capacity, plan ahead, and stay flexible. Relationships become more sustainable when both people respect their needs, communicate their limits, and make practical adjustments that support mutual well-being."
          },
          {
            "paragraphIndex": 4,
            "sourceSha256": "6bbc61e74299d2e1eb38fe7bb466edcdf697e40c90a1c535aad08f386691b29a",
            "replacement": "Use the second pass to integrate the lessons, honor the process, and strengthen the new pattern."
          },
          {
            "paragraphIndex": 5,
            "sourceSha256": "1a0b5e9286e6f57a3ce56560553021f68d7ede7e0090f9dc1e9ff6d543a9193e",
            "replacement": "Jupiter opposes your natal Mars on October 20. This transit expands desire, action, conflict, and the need for greater honesty about what you want."
          },
          {
            "paragraphIndex": 6,
            "sourceSha256": "1512ae53d2901be1619aa2aaf75a9d4603b105e0e735192d00366867bd4f5a3a",
            "replacement": "You may experience differences involving sex, timing, money, travel, work, holidays, initiation, payment, or compromise. Practice direct communication, make space for both perspectives, and avoid letting conflict become larger than the issue itself."
          },
          {
            "paragraphIndex": 7,
            "sourceSha256": "8112cccac52e2c48a8ee8e63efc16e04290bc38393eebb72c8f3e5b59a5db83c",
            "replacement": "Stay grounded and communicate with intention. Do not assume one disagreement defines the entire relationship. Approach differences with patience, honesty, compassion, and mutual respect so the connection can grow through a clearer understanding of each person's needs and values."
          },
          {
            "paragraphIndex": 8,
            "sourceSha256": "4bb101c7e98fc8adf6db9de265b226cad3780192bdbde66fedda22b4305d02df",
            "replacement": "Every conflict can become an opportunity for growth and deeper alignment."
          },
          {
            "paragraphIndex": 9,
            "sourceSha256": "4165605ae0a1a8e5e1627273195ecdb8602cc1cb6f0983a8682210fbf44e68f7",
            "replacement": "Jupiter opposes Mars again in February. Use October to identify the issue, learn from the disagreement, and prepare for the next stage with greater clarity, confidence, and awareness."
          }
        ]
      },
