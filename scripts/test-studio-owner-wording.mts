try {
 let row=store.rows.get(id);
 const saved=await store.invoke('PATCH',{id,expectedUpdatedAt:row.updated_at,body:prose});
 assert.equal(saved.status,200,JSON.stringify(saved.payload));row=saved.payload.rows[0];
 const stale=await store.invoke('PATCH',{id,expectedUpdatedAt:'2000-01-01T00:00:00Z',ownerAction:'publish-owner-content'});
 assert.equal(stale.status,409);
 const live=await store.invoke('PATCH',{id,expectedUpdatedAt:row.updated_at,ownerAction:'publish-owner-content'});
 assert.equal(live.status,200,JSON.stringify(live.payload));row=live.payload.rows[0];
 const read=await store.invoke('POST',{keys:[row.content_key]},'/api/content-reader');
 assert.equal(read.status,200);assert.equal(read.payload.rows[0].body,prose);
 const content={id:row.id,contentKey:row.content_key,body:row.body,summary:row.summary,headline:row.headline,updatedAt:row.updated_at,status:row.status,judgeGate:row.judge_gate,judgeScore:null,sourceSnapshot:row.source_snapshot};
 assert.deepEqual(generatedContentParagraphs(content as any),prose.split('\n\n'),'Owner paragraphs and intentional repetitions remain intact.');
 assert(resolveSkyAspectGeneratedContent({first:'chiron',second:'nodes',aspect:'sextile',firstSign:'taurus',secondSign:'aquarius',generatedContent:new Map([[row.content_key,content]])} as any),'The app-facing card must preserve owner wording.');
 const key=[...servingPackageRecords.keys()].find(key=>key.startsWith('fallback-hook/synastry-pair/')&&!/soft|hard/u.test(key))!;
 assert(key);
 const record={...structuredClone(servingPackageRecords.get(key)),reader_content_type:'astrology'};
 const packageRow={id:'a0000000-0000-4000-8000-000000000982',content_key:key,surface:'synastry',mode:'in_depth',status:'DRAFT',lane:'reference',review_state:null,provider:'tldrastro-fallback-architecture-v3',block_type:'fallback_hook',event_type:'fallback-hook',headline:record.headline,summary:'',body:record.body_you,facts:{fallbackArchitectureV3:true},source_snapshot:{sourcePackage:'tldrastro-fallback-architecture-v3'},updated_at:'2026-10-31T12:00:00Z',sections:{packageRecord:record,packageOriginalRecord:structuredClone(record)}};
 store.rows.set(packageRow.id,packageRow);
 const draft=await store.invoke('PATCH',{id:packageRow.id,expectedUpdatedAt:packageRow.updated_at,ownerAuthoredWording:true,sections:{...packageRow.sections,packageDraft:{...record,body_you:prose,body_they:prose}}});
 assert.equal(draft.status,200,JSON.stringify(draft.payload));
 assert.equal(nodeEligible({...record,body_you:prose,body_they:prose}),false,'A draft cannot gain owner approval.');
 const publication=await store.invoke('PATCH',{id:packageRow.id,expectedUpdatedAt:draft.payload.rows[0].updated_at,ownerAction:'approve-package-revision'});
 assert.equal(publication.status,200,JSON.stringify(publication.payload));
 const publishedRow=publication.payload.rows[0];
 const published=publishedRow.sections.packageRecord;
