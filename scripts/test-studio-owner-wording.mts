 const {createTransitSynastryRenderer:sourceFactory}=await import('../apps/web/src/content/fallbackArchitectureV3/resolver/renderTransitSynastry.browser');
 const {createTransitSynastryRenderer:shippedFactory}=await import('../apps/web/src/content/fallbackArchitectureV3/dist/tldr-content.js');
 const {readFile}=await import('node:fs/promises');
 const templates=JSON.parse(await readFile('apps/web/src/content/fallbackArchitectureV3/templates/fallback-templates-v3.json','utf8'));
 const [,,planetA,planetB,aspect]=key.split('/');
 for(const factory of [sourceFactory,shippedFactory]) {
   const result=factory({authoredCards:[]},templates,{hookRows:[published],vocabularyRows:[]}).renderSynastryAspect({planetA,planetB,aspect,otherName:'Synthetic'});
   assert.equal(result.body,prose.replace(/\s+/gu,' '),'Source and shipped readers preserve every word in reading order.');
 }
 const packageRead=await store.invoke('POST',{keys:[key]},'/api/content-reader');
 assert.equal(packageRead.payload.rows[0].sections.packageRecord.body_you,prose);
 const delivered={...record,...packageRead.payload.rows[0].sections.packageRecord};
 for(const eligible of [nodeEligible,browserEligible])assert.equal(eligible(delivered),true,'The public projection retains the owner publication proof.');
 assert.deepEqual(publication.payload.rows[0].sections.packageOriginalRecord,record);
 const tampered=structuredClone(publishedRow);tampered.sections.packageRecord.body_you+=' Unapproved change.';store.rows.set(tampered.id,tampered);
 const refused=await store.invoke('POST',{keys:[key]},'/api/content-reader');assert.deepEqual(refused.payload.rows,[],'A wording receipt cannot authorize different bytes.');
 store.rows.set(publishedRow.id,publishedRow);
 console.log('PASS owner wording: actual save/publish/read preserves Tarot, dates, degree, quoted notes, punctuation and vocabulary; stale writes and unapproved drafts remain refused.');
}finally{store.close();await rm(paragraphBundle,{force:true});}
