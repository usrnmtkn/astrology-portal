{
  "_meta": {
    "title": "Marie Satori full-corpus audit — replacement-tier CONFIRMED lines",
    "tier": "CONFIRMED",
    "provenance": "Verbatim from Marie Satori public articles (54-article audit). Stored verbatim; routing via metadata, never rewritten.",
    "scope_rule": "scope='universal' lines may serve any matching transit card. scope='sign:<x>' lines stay OUT of the universal pool and only serve their sign context. paired lines keep pair_with and are separately searchable.",
    "editorial": "Prefer 6-16 words. Reject fragments that cannot stand alone. Prefer concrete images/decisions/bodily signals over generic healing/truth/transformation."
  },
  "lines": [
    {"id": "ms/audit/idea-actionable", "text": "Today is useful for moving an idea out of your head and into something actionable.", "themes": ["ideas","communication","action"], "flavor": "affirming", "scope": "universal", "source": "confirmed-Marie bank"},
    {"id": "ms/audit/host-becoming", "text": "You are the host now. You are becoming again. You are invited to show up as someone who can hold more.", "themes": ["care","responsibility","capacity"], "flavor": "affirming", "scope": "sign:jupiter-in-cancer", "source": "What Jupiter in Cancer Means for Your Sign", "note": "paired source unit; do NOT use 'You are the host now.' as a standalone"},
    {"id": "ms/audit/mercury-taurus-01", "text": "It's the kind of transit that reveals what you’ve been pretending not to know.", "themes": ["truth","realization"], "flavor": "challenge", "scope": "sign:mercury-in-taurus", "source": "Mercury in Taurus 2025", "pair_with": "ms/audit/mercury-taurus-02"},
    {"id": "ms/audit/mercury-taurus-02", "text": "Or you stay silent, and feel what that silence costs.", "themes": ["silence","consequence"], "flavor": "challenge", "scope": "sign:mercury-in-taurus", "source": "Mercury in Taurus 2025", "pair_with": "ms/audit/mercury-taurus-01"},

    {"id": "ms/audit/mars/01", "text": "If something falls apart now, it likely needed to.", "themes": ["endings","action","courage"], "flavor": "challenge", "scope": "universal", "group": "mars", "source": "Sagittarius Full Moon 2025"},
    {"id": "ms/audit/mars/02", "text": "The courage to choose differently lives here.", "themes": ["courage","choice","change"], "flavor": "affirming", "scope": "universal", "group": "mars", "source": "Sagittarius Full Moon 2025"},
    {"id": "ms/audit/mars/03", "text": "You’re here to protect your energy by caring for what you can control.", "themes": ["protection","agency","limits"], "flavor": "affirming", "scope": "universal", "group": "mars", "source": "Monthly Astrology: June 2025"},
    {"id": "ms/audit/mars/04", "text": "This is about stopping the war with who you already are.", "themes": ["conflict","self-acceptance"], "flavor": "challenge", "scope": "universal", "group": "mars", "source": "Virgo New Moon: August 23, 2025"},
    {"id": "ms/audit/mars/05", "text": "Stop waiting for the perfect moment to begin.", "themes": ["action","perfectionism"], "flavor": "challenge", "scope": "universal", "group": "mars", "source": "Virgo New Moon: August 23, 2025"},
    {"id": "ms/audit/mars/06", "text": "The body holds what the mind won’t.", "themes": ["body","anger","memory"], "flavor": "challenge", "scope": "universal", "group": "mars", "source": "Chiron Retrograde in Aries"},
    {"id": "ms/audit/mars/07", "text": "Mars in Cancer doesn’t fight to win, it fights to protect.", "themes": ["protection","conflict","care"], "flavor": "affirming", "scope": "universal", "group": "mars", "source": "Mars Direct in Cancer"},
    {"id": "ms/audit/mars/08", "text": "What was the fight for? What were you defending?", "themes": ["conflict","protection","reflection"], "flavor": "challenge", "scope": "universal", "group": "mars", "source": "Mars Direct in Cancer"},
    {"id": "ms/audit/mars/09", "text": "What are you willing to fight for? What deserves your determination?", "themes": ["courage","commitment","purpose"], "flavor": "challenge", "scope": "universal", "group": "mars", "source": "Saturn Enters Aries 2025"},
    {"id": "ms/audit/mars/10", "text": "Do it, but don't confuse busyness with progress.", "themes": ["action","discernment","momentum"], "flavor": "challenge", "scope": "universal", "group": "mars", "source": "Weekly Horoscopes: September 7–14, 2025"},

    {"id": "ms/audit/moon/01", "text": "You’re allowed to soften. You’re allowed to receive. You’re allowed to rest.", "themes": ["rest","receiving","care"], "flavor": "affirming", "scope": "universal", "group": "moon", "source": "Aquarius Full Moon 2025"},
    {"id": "ms/audit/moon/02", "text": "You can’t do everything alone anymore. At least not without it breaking you.", "themes": ["support","limits","vulnerability"], "flavor": "challenge", "scope": "universal", "group": "moon", "source": "Aquarius Full Moon 2025"},
    {"id": "ms/audit/moon/03", "text": "This is the kind of love that remembers your favorite song.", "themes": ["love","memory","care"], "flavor": "affirming", "scope": "universal", "group": "moon", "source": "Venus in Cancer 2025"},
    {"id": "ms/audit/moon/04", "text": "You don’t need to armor up to be loved.", "themes": ["love","safety","receiving"], "flavor": "affirming", "scope": "universal", "group": "moon", "source": "Venus in Cancer 2025"},
    {"id": "ms/audit/moon/05", "text": "This is the Jupiter of wells, wombs, kitchens, and kin.", "themes": ["home","belonging","abundance"], "flavor": "affirming", "scope": "universal", "group": "moon", "source": "What Jupiter in Cancer Means for Your Sign"},
    {"id": "ms/audit/moon/06", "text": "Real care needs a structure, a schedule and not just sentiment.", "themes": ["care","structure","responsibility"], "flavor": "challenge", "scope": "universal", "group": "moon", "source": "Monthly Astrology: June 2025"},
    {"id": "ms/audit/moon/07", "text": "Without a supportive foundation, it’s nearly impossible to thrive.", "themes": ["foundation","safety","support"], "flavor": "affirming", "scope": "universal", "group": "moon", "source": "Cancer Full Moon"},
    {"id": "ms/audit/moon/08", "text": "Connection begins with honesty, and honesty begins with you.", "themes": ["connection","honesty","self-awareness"], "flavor": "affirming", "scope": "universal", "group": "moon", "source": "Cancer Full Moon"},
    {"id": "ms/audit/moon/09", "text": "Success is remaining open when closing would have been easier.", "themes": ["openness","vulnerability","resilience"], "flavor": "affirming", "scope": "universal", "group": "moon", "source": "Pisces Full Moon Eclipse"},
    {"id": "ms/audit/moon/10", "text": "Your emotions aren't symptoms to cure. They're your navigation system.", "themes": ["emotion","intuition","guidance"], "flavor": "affirming", "scope": "universal", "group": "moon", "source": "Pisces Full Moon Eclipse"},

    {"id": "ms/audit/mercury/01", "text": "Stop minimizing what you know.", "themes": ["knowing","voice","confidence"], "flavor": "challenge", "scope": "universal", "group": "mercury", "source": "Gemini Season 2025"},
    {"id": "ms/audit/mercury/02", "text": "Words are choices that reveal alignment or avoidance.", "themes": ["language","discernment","honesty"], "flavor": "challenge", "scope": "universal", "group": "mercury", "source": "Gemini Season 2025"},
    {"id": "ms/audit/mercury/03", "text": "This is when your words become your commitments.", "themes": ["speech","commitment","responsibility"], "flavor": "affirming", "scope": "universal", "group": "mercury", "source": "Saturn Enters Aries 2025"},
    {"id": "ms/audit/mercury/04", "text": "What do you know vs. what do you believe?", "themes": ["knowing","belief","discernment"], "flavor": "challenge", "scope": "universal", "group": "mercury", "source": "Sagittarius Full Moon 2025"},
    {"id": "ms/audit/mercury/05", "text": "The unspoken weighs heavy.", "themes": ["silence","truth","communication"], "flavor": "challenge", "scope": "universal", "group": "mercury", "source": "Leo Full Moon"},
    {"id": "ms/audit/mercury/06", "text": "Say it badly if you have to.", "themes": ["voice","courage","imperfection"], "flavor": "affirming", "scope": "universal", "group": "mercury", "source": "Virgo New Moon: August 23, 2025"},
    {"id": "ms/audit/mercury/07", "text": "You might want to be liked more than you want to be heard.", "themes": ["voice","approval","honesty"], "flavor": "challenge", "scope": "universal", "group": "mercury", "source": "Astrological Overview: August 3–9"},
    {"id": "ms/audit/mercury/08", "text": "Your brain needs rest. You are allowed to be human.", "themes": ["mind","rest","self-acceptance"], "flavor": "affirming", "scope": "universal", "group": "mercury", "source": "Mercury Enters Virgo"},
    {"id": "ms/audit/mercury/09", "text": "Virgo’s precision no longer needs to be a weapon turned against yourself.", "themes": ["thought","criticism","care"], "flavor": "affirming", "scope": "universal", "group": "mercury", "source": "Mercury Enters Virgo"},
    {"id": "ms/audit/mercury/10", "text": "Sometimes the only move is to make peace with not knowing.", "themes": ["uncertainty","reflection","surrender"], "flavor": "affirming", "scope": "universal", "group": "mercury", "source": "Mercury Retrograde in Leo 2025"},

    {"id": "ms/audit/jupiter/01", "text": "Jupiter in Cancer is about building trust.", "themes": ["trust","growth","belonging"], "flavor": "affirming", "scope": "universal", "group": "jupiter", "source": "What Jupiter in Cancer Means for Your Sign"},
    {"id": "ms/audit/jupiter/02", "text": "Boundary work becomes sacred.", "themes": ["boundaries","care","growth"], "flavor": "affirming", "scope": "universal", "group": "jupiter", "source": "What Jupiter in Cancer Means for Your Sign"},
    {"id": "ms/audit/jupiter/03", "text": "What will you create from the ashes of what’s no longer working?", "themes": ["creation","renewal","possibility"], "flavor": "challenge", "scope": "universal", "group": "jupiter", "source": "Aquarius New Moon 2025"},
    {"id": "ms/audit/jupiter/04", "text": "Transformation begins in the dark.", "themes": ["transformation","beginnings","faith"], "flavor": "affirming", "scope": "universal", "group": "jupiter", "source": "Aquarius New Moon 2025"},
    {"id": "ms/audit/jupiter/05", "text": "This is the rhythm of becoming: intention, expansion, reflection, renewal.", "themes": ["growth","cycles","renewal"], "flavor": "affirming", "scope": "universal", "group": "jupiter", "source": "2025 New and Full Moons"},
    {"id": "ms/audit/jupiter/06", "text": "What do you long for?", "themes": ["desire","possibility","growth"], "flavor": "challenge", "scope": "universal", "group": "jupiter", "source": "2025 New and Full Moons"},
    {"id": "ms/audit/jupiter/07", "text": "This world is deeply incomplete without your authentic voice.", "themes": ["confidence","contribution","expansion"], "flavor": "affirming", "scope": "universal", "group": "jupiter", "source": "Libra New Moon 2025"},
    {"id": "ms/audit/jupiter/08", "text": "Not one of us is too much for the right connections.", "themes": ["belonging","confidence","relationship"], "flavor": "affirming", "scope": "universal", "group": "jupiter", "source": "Libra New Moon 2025"},
    {"id": "ms/audit/jupiter/09", "text": "Breathe—give the situation time to unfold!", "themes": ["patience","faith","perspective"], "flavor": "affirming", "scope": "universal", "group": "jupiter", "source": "Over-reading: Asking the Same Psychic Question"},
    {"id": "ms/audit/jupiter/10", "text": "Free will plays a role in how an event unfolds.", "themes": ["choice","possibility","agency"], "flavor": "affirming", "scope": "universal", "group": "jupiter", "source": "Predicting Exact Dates in Psychic Readings"},

    {"id": "ms/audit/neptune/01", "text": "You can’t control your way to peace.", "themes": ["surrender","control","peace"], "flavor": "challenge", "scope": "universal", "group": "neptune", "source": "Astrology: August 30–September 7"},
    {"id": "ms/audit/neptune/02", "text": "The chaos you've been trying to prevent might have been the breakthrough you needed.", "themes": ["chaos","surrender","revelation"], "flavor": "affirming", "scope": "universal", "group": "neptune", "source": "Astrology: August 30–September 7"},
    {"id": "ms/audit/neptune/03", "text": "This is where you let the ocean decide.", "themes": ["surrender","intuition","uncertainty"], "flavor": "affirming", "scope": "universal", "group": "neptune", "source": "Pisces Season"},
    {"id": "ms/audit/neptune/04", "text": "You don’t need to articulate what you’re feeling. You already know.", "themes": ["intuition","feeling","knowing"], "flavor": "affirming", "scope": "universal", "group": "neptune", "source": "Pisces Season"},
    {"id": "ms/audit/neptune/05", "text": "This is a breaking point disguised as a breakthrough.", "themes": ["uncertainty","breakthrough","restraint"], "flavor": "challenge", "scope": "universal", "group": "neptune", "source": "Total Lunar Eclipse in Virgo"},
    {"id": "ms/audit/neptune/06", "text": "What’s in motion now is still unfolding.", "themes": ["uncertainty","patience","becoming"], "flavor": "affirming", "scope": "universal", "group": "neptune", "source": "Total Lunar Eclipse in Virgo"},
    {"id": "ms/audit/neptune/07", "text": "This is the point where you let go.", "themes": ["surrender","release","trust"], "flavor": "affirming", "scope": "universal", "group": "neptune", "source": "Pisces New Moon"},
    {"id": "ms/audit/neptune/08", "text": "But you don’t get to simply float here.", "themes": ["avoidance","action","grounding"], "flavor": "challenge", "scope": "universal", "group": "neptune", "source": "Pisces New Moon"},
    {"id": "ms/audit/neptune/09", "text": "Not everything that sounds good is true.", "themes": ["illusion","discernment","truth"], "flavor": "challenge", "scope": "universal", "group": "neptune", "source": "Leo Full Moon"},
    {"id": "ms/audit/neptune/10", "text": "You are not meant to push harder right now, just sit back and observe.", "themes": ["surrender","observation","timing"], "flavor": "affirming", "scope": "universal", "group": "neptune", "source": "Eclipse Season: Pisces New Moon to Pisces Total Lunar Eclipse"},

    {"id": "ms/audit/pluto/01", "text": "Scorpio doesn't kill what's alive. It names what's already dead.", "themes": ["endings","truth","transformation"], "flavor": "challenge", "scope": "universal", "group": "pluto", "source": "Full Moon in Taurus"},
    {"id": "ms/audit/pluto/02", "text": "Transformation isn't the breakdown, refusing it will be.", "themes": ["transformation","resistance","truth"], "flavor": "challenge", "scope": "universal", "group": "pluto", "source": "Full Moon in Taurus"},
    {"id": "ms/audit/pluto/03", "text": "The old version of you is dead.", "themes": ["identity","ending","rebirth"], "flavor": "challenge", "scope": "universal", "group": "pluto", "source": "Uranus Direct in Taurus 2025"},
    {"id": "ms/audit/pluto/04", "text": "The structures we once relied on are breaking.", "themes": ["systems","breakdown","transformation"], "flavor": "challenge", "scope": "universal", "group": "pluto", "source": "Uranus Direct in Taurus 2025"},
    {"id": "ms/audit/pluto/05", "text": "Pluto strips away illusions, exposing the truth underneath.", "themes": ["power","truth","exposure"], "flavor": "challenge", "scope": "universal", "group": "pluto", "source": "Aquarius Season 2025"},
    {"id": "ms/audit/pluto/06", "text": "It turns its transformative lens inward.", "themes": ["transformation","reflection","shadow"], "flavor": "challenge", "scope": "universal", "group": "pluto", "source": "Aquarius Season 2025"},
    {"id": "ms/audit/pluto/07", "text": "What was once unclear now sharpens into focus.", "themes": ["revelation","truth","clarity"], "flavor": "affirming", "scope": "universal", "group": "pluto", "source": "Venus Retrograde 2025"},
    {"id": "ms/audit/pluto/08", "text": "The past releases its grip.", "themes": ["release","history","liberation"], "flavor": "affirming", "scope": "universal", "group": "pluto", "source": "Venus Retrograde 2025"},
    {"id": "ms/audit/pluto/09", "text": "The dream fades. Reality returns.", "themes": ["disillusionment","truth","return"], "flavor": "challenge", "scope": "universal", "group": "pluto", "source": "Venus Retrograde 2025"},
    {"id": "ms/audit/pluto/10", "text": "Some things are meant to end.", "themes": ["endings","acceptance","transformation"], "flavor": "affirming", "scope": "universal", "group": "pluto", "source": "Venus Retrograde 2025"}
  ]
}
