  "firstWritingCallExclusions": [
    "current and previous AI candidates",
    "assistant-generated rewrites",
    "contrastive rejected text",
    "negative examples",
    "failure tags",
    "source-selection explanations",
    "candidate-language ranking",
    "judge scores or explanations",
    "calibration results",
    "central-contradiction metadata",
    "governance reports"
  ],
