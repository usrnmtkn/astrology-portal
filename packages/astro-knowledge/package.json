{
  "name": "@tldr/astro-knowledge",
  "version": "0.1.0",
  "description": "Standalone astrology knowledge-base bundle for web and React Native consumers.",
  "main": "dist/knowledge.json",
  "files": [
    "dist",
    "engine/aspect-patterns",
    "engine/timing",
    "docs",
    "aspect-pattern-contract.json",
    "aspect-pattern-templates-v3.7.md",
    "aspect-pattern-templates-v3.3.md",
    "aspect-pattern-tables-v1.md",
    "aspect-pattern-sample-renders.md",
    "README.md"
  ],
  "exports": {
    ".": "./dist/knowledge.json",
    "./sky": "./dist/sky.json",
    "./sky-web": "./dist/sky-web.json",
    "./natal": "./dist/natal.json",
    "./natal-web": "./dist/natal-web.json",
    "./relationships": "./dist/relationships.json",
    "./relationships-web": "./dist/relationships-web.json",
    "./synastry": "./dist/synastry.json",
    "./composite": "./dist/composite.json",
    "./web": "./dist/web.json",
    "./rewrite-corpora": "./dist/rewrite-corpora.json",
    "./index": "./dist/knowledge.index.json",
    "./entries/*": "./dist/entries/*.json",
    "./aspect-pattern-engine": {
      "types": "./engine/aspect-patterns/index.d.ts",
      "import": "./engine/aspect-patterns/index.js",
      "require": "./engine/aspect-patterns/index.js"
    },
    "./timing-engine": {
      "types": "./engine/timing/index.d.ts",
      "import": "./engine/timing/browser.js",
      "require": "./engine/timing/index.js"
    }
  },
  "scripts": {
    "validate": "node scripts/validate.js",
    "lint:sky-voice": "node scripts/lint-sky-voice.js --examples",
    "test:judge-calibration": "node scripts/test-judge-calibration.js",
    "calibrate:sky-judge:live": "node scripts/test-judge-calibration.js --authorize-live",
    "test:placement-calibration": "node scripts/test-placement-calibration.js",
    "calibrate:placement-card-judge:live": "node scripts/test-placement-calibration.js --authorize-live",
    "test:placement-engine": "node scripts/test-placement-engine.js",
    "lint:placement-voice": "node scripts/lint-placement-voice.js --exemplars",
    "test:placement-pipeline": "node scripts/test-placement-pipeline.js",
    "test:placement-judge-calibration": "node scripts/test-placement-judge-calibration.js",
    "calibrate:placement-article-judge:live": "node scripts/test-placement-judge-calibration.js --authorize-live",
    "lint:article-voice": "node scripts/lint-article-voice.js --fixtures",
    "test:article-voice-routing": "node scripts/test-article-voice-routing.js",
    "test:article-judge-calibration": "node scripts/test-article-judge-calibration.js",
    "calibrate:article-judge:live": "node scripts/test-article-judge-calibration.js --authorize-live",
    "private-model:export": "node private-model/scripts/export-sky-longform.mjs",
    "private-model:validate": "node private-model/scripts/validate-dataset.mjs",
    "test:private-model-data": "npm run private-model:export && npm run private-model:validate -- --allow-insufficient",
    "import:v4-rewrites": "node scripts/import-v4-rewrites.js",
    "build": "node scripts/import-v4-rewrites.js && node scripts/import-authored-placements.js && node scripts/build.js",
    "test:timing": "node scripts/test-timing-engine.js",
    "test:aspect-patterns": "node scripts/test-aspect-pattern-engine.js",
    "test:aspect-patterns-v3": "node scripts/test-aspect-pattern-v3-resolver.js",
    "fixtures:aspect-patterns": "node scripts/print-aspect-pattern-fixtures.js",
    "fixtures:aspect-patterns-v3": "node scripts/print-aspect-pattern-v3-real-renders.js",
    "fixtures:aspect-pattern-activations": "node scripts/print-aspect-pattern-activation-fixtures.js",
    "import:authored-placements": "node scripts/import-authored-placements.js",
    "lint:pattern-voice": "node scripts/lint-pattern-voice.js --examples",
    "lint:editorial-bank": "node scripts/judge-editorial-source-bank.js --lint",
    "test:pattern-voice": "node scripts/test-pattern-voice.mjs"
  },
  "license": "UNLICENSED",
  "private": true
}
