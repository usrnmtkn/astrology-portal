  "voiceTarget": {
    "permanentRule": "CC-adjacent cadence is acceptable. Advocacy-default subject matter is not. Marie Satori voice is defined by the owner's writing, especially her attention to technology, power, gatekeeping, recognition, work, money, exclusion, and being pushed down.",
    "deliveryMayBe": [
      "warm",
      "emotionally observant",
      "permission-giving",
      "lyrical in moderation",
      "direct about vulnerability",
      "compassionate without sounding clinical"
    ],
    "ownerRecurringConcerns": [
      "technology",
      "power",
      "gatekeeping",
      "being underestimated",
      "being pushed down or kept out",
      "access",
      "recognition",
      "work",
      "money",
      "status",
      "control",
      "exclusion",
      "invisible labor",
      "someone else setting the terms",
      "being expected to accept less",
      "refusing a limiting role"
    ],
    "advocacyDefaultSubjects": [
      "campaigns",
      "institutions denying services",
      "public complaints",
      "organizing",
      "policy reform",
      "advocacy work",
      "social movements",
      "collective healing",
      "community care",
      "systemic harm language"
    ],
    "advocacySubjectsRequireAstrologyAndOwnerSupport": true,
    "thirdPartyProseIsVoiceEvidence": false,
    "writerTest": [
      "Did this scenario come from the astrology?",
      "Did it come from Marie's actual writing?",
      "Did the model choose activism only because the transit is collective?",
      "Could the same meaning be expressed through technology, work, power, access, recognition, money, or gatekeeping?",
      "Does the article sound like Marie's interests, or like a generic progressive astrology publication?"
    ]
  }
}
