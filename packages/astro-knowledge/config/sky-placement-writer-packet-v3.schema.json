{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tldrastro.local/schemas/sky-placement-writer-packet-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packetVersion", "positiveEvidencePoolId", "formatExemplars", "formatExemplarStatus", "ownerReferenceArticles", "ownerSelectedBenchmarks", "ownerCorpusWarmthEvidence", "routing", "verifiedAstrology", "surfaceRequirements", "voiceDevices", "movesExemplar", "task", "ownerPassages", "preferredVocabulary", "structuralSlots", "writerPrompt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "packetVersion": { "const": "sky-placement-writer-packet-v3:affinity-ov039-vocab-structural-v3:self-lint-v1:connection-domain-v1:owner-reference-v1:owner-benchmark-v1:engine-cycle-fact-v1:corpus-warmth-v2-none-found:node-axis-v1" },
    "positiveEvidencePoolId": { "const": "sky-placement-owner-affinity-v1" },
    "formatExemplars": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "planet", "sign", "authorityClass", "approvalScope", "article"],
        "properties": {
          "authorityClass": { "const": "exact_owner_approved" },
          "approvalScope": { "const": "voice_format_generation_evidence_only" },
          "article": {
            "type": "object",
            "required": ["tagline", "hook", "lived", "turn", "moves"]
          }
        }
      }
    },
    "formatExemplarStatus": { "const": "owner_approved_voice_format_evidence" },
    "ownerReferenceArticles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "planet", "sign", "authorityClass", "approvalScope", "article"],
        "properties": {
          "id": { "const": "sky-placement-jupiter-libra-owner-merged-candidate-v1" },
          "authorityClass": { "const": "exact_owner_approved" },
          "approvalScope": { "const": "owner_reference_fallback_and_generation_evidence_for_sky_placement" },
          "article": {
            "type": "object",
            "required": ["opening", "tension", "development", "close", "try_this"]
          }
        }
      }
    },
    "ownerSelectedBenchmarks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "planet", "sign", "authorityClass", "authorship", "approvalScope", "benchmarkText", "benchmarkRules"],
        "properties": {
          "id": { "const": "sky-placement-mars-aries-owner-selected-generation-benchmark-v1" },
          "authorityClass": { "const": "exact_owner_approved" },
          "authorship": { "const": "assistant_generated_owner_selected" },
          "approvalScope": { "const": "generation_evidence_and_surface_benchmark_only" },
          "benchmarkText": { "type": "string", "minLength": 1 },
          "benchmarkRules": { "type": "array", "minItems": 1 }
        }
      }
    },
    "ownerCorpusWarmthEvidence": {
      "type": "object",
      "required": ["id", "planet", "sign", "harvest_mode", "emotionalCore", "searchTerms", "primary", "authorityClass", "maxWarmthBeats", "method", "sourceIds", "editorial_flags"],
      "properties": {
        "harvest_mode": { "enum": ["matched", "none_found"] },
        "authorityClass": { "enum": ["owner_corpus_derived_foundation", "owner_corpus_no_match"] },
        "maxWarmthBeats": { "enum": [0, 1] },
        "primary": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["foundationText", "sourceId", "sourcePath", "sourceExcerpt", "adaptation"]
            }
          ]
        },
        "sourceIds": { "type": "array", "items": { "type": "string" } },
        "editorial_flags": { "type": "array" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["laneId", "releaseId", "registryState", "requestedModel", "requestedReasoningEffort", "promptVersion"],
      "properties": {
        "laneId": { "const": "writer:sky-placement" },
        "releaseId": { "const": "sky-placement-writer-openai-gpt-5.6-sol-candidate-v2" },
        "registryState": { "const": "candidate" },
        "requestedModel": { "const": "gpt-5.6-sol" },
        "requestedReasoningEffort": { "const": "xhigh" },
        "promptVersion": { "const": "sky-placement-writer-v15:cross-batch-move-variety-v1" }
      }
    },
    "verifiedAstrology": { "type": "object" },
    "surfaceRequirements": {
      "type": "object",
      "required": ["runtimeContractId", "generatedSlots", "engineOwnedSlots"],
      "properties": {
        "runtimeContractId": { "const": "sky-placement-continuous-v2" },
        "generatedSlots": { "const": ["opening", "tension", "development", "close", "try_this"] },
        "engineOwnedSlots": { "const": ["headline", "fact_line", "cycle_fact_line", "aspect_insert", "entryDate", "exitDate", "priorSign", "priorSignEntryDate", "priorSignExitDate", "previousResidencyEntryDate", "previousResidencyExitDate"] }
      }
    },
    "voiceDevices": {
      "type": "object",
      "required": ["maxPerArticle", "selected"],
      "properties": {
        "maxPerArticle": { "type": "integer", "maximum": 2 },
        "selected": { "type": "array", "maxItems": 2 }
      }
    },
    "movesExemplar": { "type": "object" },
    "task": { "type": "object" },
    "ownerPassages": { "type": "array", "minItems": 4, "maxItems": 6 },
    "preferredVocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceBankId", "authority", "use", "selection", "words", "phrases"],
      "properties": {
        "sourceBankId": { "const": "owner-vocabulary-bank-v1" },
        "authority": { "const": "owner-first" },
        "use": { "const": "optional_menu_not_quota" },
        "words": { "type": "array", "minItems": 1, "maxItems": 12 },
        "phrases": { "type": "array", "maxItems": 3 }
      }
    },
    "structuralSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceStatus", "fallbackOutputShapeUnchanged", "active", "inactive"],
      "properties": {
        "sourceStatus": { "enum": ["DRAFT", "REVIEWED", "APPROVED", "LIVE"] },
        "fallbackOutputShapeUnchanged": { "const": true },
        "active": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "rule", "requiresFact", "maxOccurrences", "continuousFallbackTarget", "renderOwner", "facts"],
            "properties": {
              "id": { "enum": ["prior-sign-handoff", "cycle-line", "concurrent-events", "cycle-location"] },
              "maxOccurrences": { "const": 1 }
            }
          }
        },
        "inactive": { "type": "array" }
      }
    },
    "writerPrompt": { "type": "string", "minLength": 1 }
  }
}
