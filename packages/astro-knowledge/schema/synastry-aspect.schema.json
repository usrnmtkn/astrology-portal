{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/synastry-aspect.schema.json",
  "title": "Synastry Aspect Entry",
  "type": "object",
  "required": ["id", "kind", "planetA", "planetB", "aspect", "plainTranslation", "policy", "voiceNeutral", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "kind": { "type": "string", "enum": ["interaspect"] },
    "planetA": { "type": "string" },
    "planetB": { "type": "string" },
    "aspect": { "type": "string" },
    "plainTranslation": { "type": "string" },
    "summaryShort": { "type": "string" },
    "summaryDeep": { "type": "string" },
    "tension": { "type": "string" },
    "advice": { "type": "string" },
    "weight": { "type": "number" },
    "authoringStatus": { "type": "string", "enum": ["draft", "approved", "locked"] },
    "policy": { "type": "string" },
    "note": { "type": "string" },
    "voiceNeutral": { "const": true },
    "status": { "type": "string", "enum": ["TODO", "DRAFT", "REVIEWED", "LIVE"] }
  }
}
