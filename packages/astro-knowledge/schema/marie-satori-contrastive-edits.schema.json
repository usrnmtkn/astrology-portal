{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tldrastro.local/schema/marie-satori-contrastive-edits.schema.json",
  "type": "object",
  "required": ["schemaVersion", "datasetId", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "surface", "articleBeat", "before", "after", "failureTags", "approvalLevel", "sourcePaths", "provenance"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "planet": { "type": "string" },
          "sign": { "type": "string" },
          "articleBeat": { "type": "string", "minLength": 1 },
          "before": { "type": "string", "minLength": 1 },
          "after": { "type": "string", "minLength": 1 },
          "whatChanged": { "type": "string" },
          "ownerReason": { "type": "string" },
          "reasonSource": { "type": "string" },
          "failureTags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "approvalLevel": { "type": "string", "minLength": 1 },
          "sourcePaths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "provenance": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
