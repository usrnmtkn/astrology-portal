{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astro-knowledge.local/schema/point-transit-house.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "point", "house", "tldr", "body", "business", "shadow", "advice", "policy", "voiceNeutral", "status"],
  "properties": {
    "id": { "type": "string" },
    "kind": { "const": "house" },
    "point": { "type": "string" },
    "house": { "type": "integer", "minimum": 1, "maximum": 12 },
    "tldr": { "type": "string" },
    "body": { "type": "string" },
    "business": { "type": "string" },
    "shadow": { "type": "string" },
    "advice": { "type": "string" },
    "policy": { "type": "string" },
    "note": { "type": "string" },
    "voiceNeutral": { "const": true },
    "status": { "enum": ["TODO", "DRAFT", "REVIEWED", "LIVE"] }
  }
}
