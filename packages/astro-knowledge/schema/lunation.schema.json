{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/lunation.schema.json",
  "title": "Lunation Entry",
  "type": "object",
  "required": [
    "id",
    "kind",
    "phase",
    "sign",
    "title",
    "tldr",
    "theme",
    "twoWeekArc",
    "sixMonthArc",
    "ritual",
    "journalPrompt",
    "risingSignIntention",
    "policy",
    "voiceNeutral",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "kind": { "type": "string", "enum": ["new-moon", "full-moon"] },
    "phase": { "type": "string", "enum": ["new", "full"] },
    "sign": { "type": "string" },
    "oppositeSign": { "type": "string" },
    "title": { "type": "string" },
    "tldr": { "type": "string" },
    "theme": { "type": "string" },
    "shadow": { "type": "string" },
    "integration": { "type": "string" },
    "twoWeekArc": { "type": "object" },
    "sixMonthArc": { "type": "object" },
    "ritual": { "type": "object" },
    "journalPrompt": { "type": "string" },
    "tarotPrompt": { "type": "string" },
    "risingSignIntention": { "type": "object" },
    "policy": { "type": "string" },
    "sourceNote": { "type": "string" },
    "voiceNeutral": { "const": true },
    "status": { "type": "string", "enum": ["TODO", "DRAFT", "REVIEWED", "LIVE"] }
  }
}
