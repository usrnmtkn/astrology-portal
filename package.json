{
  "name": "tldrastro-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx vercel dev --listen 3000",
    "dev:web": "npm run dev -w @tldr/web",
    "build": "npm run build -w @tldr/astro-knowledge && npm run build -w @tldr/web",
    "test": "npm run typecheck && npm run build:web",
    "preview": "npm run preview -w @tldr/web",
    "typecheck": "npm run typecheck -w @tldr/web",
    "visual:smoke": "playwright test -c playwright.config.ts",
    "build:knowledge": "npm run build -w @tldr/astro-knowledge",
    "build:web": "npm run build -w @tldr/web"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.27.7",
    "@rollup/rollup-linux-x64-gnu": "^4.60.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.1"
  }
}
