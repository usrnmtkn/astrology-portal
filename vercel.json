{
  "installCommand": "npm install --include=optional",
  "devCommand": "npm run dev -w @tldr/web -- --port $PORT",
  "buildCommand": "node scripts/assert-vercel-production-source.mjs && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{api/_lib,artifacts,config,src/astro-writing,packages/astro-knowledge/{generated,scripts,data,config,reference,voice,sources/authored/marie-satori-book},apps/web/{public/content,src/content},tldr-astro-phrasebank}/**/*.{cjs,js,json,md,mjs,ts}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-sky",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/cron/generate-sky-aspects",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/generate-sky-placements",
      "schedule": "25 10 * * *"
    },
    {
      "path": "/api/cron/run-report-fulfillment",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/run-friend-report-jobs",
      "schedule": "* * * * *"
    }
  ]
}
