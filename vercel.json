{
  "installCommand": "npm install --include=optional",
  "devCommand": "npm run dev -w @tldr/web -- --port $PORT",
  "buildCommand": "node scripts/vercel-prebuild.mjs && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/wasm/:version/:asset",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/reports/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/learn",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/learn/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/friends",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/calendar-feed.ts": {
      "includeFiles": "node_modules/swisseph-wasm/wasm/*",
      "maxDuration": 60
    },
    "api/sky.ts": {
      "includeFiles": "node_modules/swisseph-wasm/wasm/*",
      "maxDuration": 15
    },
    "api/admin/sky-draft-writing.ts": {
      "includeFiles": "{api/_lib,artifacts,config,src/astro-writing,packages/astro-knowledge/{generated,scripts,data,config,reference,voice,sources/authored/owner-author-book},apps/web/{public/content,src/content},tldr-astro-phrasebank,data/writing}/**/*.{*js,json,jsonl,md,ts}"
    },
    "api/admin/sky-article-writing.ts": {
      "includeFiles": "{api/_lib,artifacts,config,src/astro-writing,packages/astro-knowledge/{generated,scripts,data,config,reference,voice,sources/authored/owner-author-book},apps/web/{public/content,src/content},tldr-astro-phrasebank,data/writing}/**/*.{*js,json,jsonl,md,ts}"
    },
    "api/admin/sky-article-template-slots.ts": {
      "includeFiles": "{api/_lib,artifacts,config,src/astro-writing,packages/astro-knowledge/{generated,scripts,data,config,reference,voice,sources/authored/owner-author-book},apps/web/{public/content,src/content},tldr-astro-phrasebank,data/writing}/**/*.{*js,json,jsonl,md,ts}"
    },
    "api/admin/personal-transit-writing.ts": {
      "includeFiles": "{api/_lib,artifacts,config,src/astro-writing,packages/astro-knowledge/{generated,scripts,data,config,reference,voice,sources/authored/owner-author-book},apps/web/{public/content,src/content},tldr-astro-phrasebank,data/writing}/**/*.{*js,json,jsonl,md,ts}"
    },
    "api/admin/generated-content-inventory.ts": {
      "includeFiles": "api/_lib/**/*.{js,ts}"
    },
    "api/admin/package-source.ts": {
      "includeFiles": "{api/_lib,apps/web/src/content}/**/*.{cjs,js,json,md,mjs,ts}"
    },
    "api/admin/memory-graph.ts": {
      "includeFiles": "{AGENTS.md,config/agent-memory-sources-v1.json,{docs/{writing,content-management},data/{writing,agent-memory},skills/tldr-astro-writer,.agents/skills/satori-writer,tldr-astro-phrasebank,packages/astro-knowledge/review}/**/*.{jsonl,md}}"
    },
    "api/**/*.ts": {
      "includeFiles": "{api/_lib,artifacts,config,src/astro-writing,packages/astro-knowledge/{generated,scripts,data,config,reference,voice,sources/authored/owner-author-book},apps/web/{public/content,src/content},tldr-astro-phrasebank}/**/*.{cjs,js,json,md,mjs,ts}"
    }
  },
  "rewrites": [
    {
      "source": "/feed/:token.ics",
      "destination": "/api/calendar-feed?token=:token"
    },
    {
      "source": "/api/admin/review-records",
      "destination": "/api/admin/review-records-fast"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-sky",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/cron/generate-sky-aspects",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/generate-sky-placements",
      "schedule": "25 10 * * *"
    },
    {
      "path": "/api/cron/run-report-fulfillment",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/run-friend-report-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/run-you-report-jobs",
      "schedule": "*/5 * * * *"
    }
  ]
}
