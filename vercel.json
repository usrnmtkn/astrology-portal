{
  "installCommand": "npm install --include=optional",
  "devCommand": "npm run dev -w @tldr/web -- --port $PORT",
  "buildCommand": "node scripts/assert-vercel-production-source.mjs && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{AGENTS.md,packages/astro-knowledge/review/{tldr-astro-lilith-fact-boundary.md,lilith-true-apogee-migration-2026-08-09.md,lilith-placements-v5/lilith-placements-v5-owner-package.md},{api/_lib,artifacts,config,docs/writing,docs/content-management,data/writing,data/agent-memory,skills/tldr-astro-writer,.agents/skills/satori-writer,src/astro-writing,packages/astro-knowledge/{generated,scripts,data,config,reference,voice,sources/authored/owner-author-book},apps/web/{public/content,src/content},tldr-astro-phrasebank}/**/*.{cjs,js,json,jsonl,md,mjs,ts}}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-sky",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/cron/generate-sky-aspects",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/generate-sky-placements",
      "schedule": "25 10 * * *"
    },
    {
      "path": "/api/cron/run-report-fulfillment",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/run-friend-report-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/run-you-report-jobs",
      "schedule": "*/5 * * * *"
    }
  ]
}
