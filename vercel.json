{
  "installCommand": "npm install --include=optional",
  "devCommand": "npm run dev -w @tldr/web -- --port $PORT",
  "buildCommand": "node scripts/assert-vercel-production-source.mjs && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{api/_lib/{content-generation.ts,report-*.ts,supabase-report-admin.ts},artifacts/*.md,config/*.json,packages/astro-knowledge/data/manifestation-sets/*.json,tldr-astro-phrasebank/*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-sky",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/cron/generate-sky-aspects",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/generate-sky-placements",
      "schedule": "25 10 * * *"
    },
    {
      "path": "/api/cron/run-report-fulfillment",
      "schedule": "*/5 * * * *"
    }
  ]
}
