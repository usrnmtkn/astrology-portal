{
  "version": "2.0.0",
  "global": {
    "sourceGapStatus": "SOURCE_GAP",
    "compactMustDifferFromExpanded": true,
    "instructionSourceFirewall": true,
    "optionalSlotsMayBeSuppressed": true,
    "prohibitedNarrativeSeams": [
      "moves through * circumstances",
      "the planet names the topic",
      "the sign describes the condition",
      "this pattern is active now",
      "choose the next concrete response",
      "use it while it lasts"
    ]
  },
  "families": {
    "personalized_transit": {
      "version": "2.0.0",
      "card": {
        "required": ["factualEventTitle", "timingDisplay", "compactSummary"],
        "optional": ["editorialHeadline", "exactDateDisplay", "durationLabel"],
        "forbidden": ["expandedNarrative", "astroFooter"]
      },
      "detail": {
        "required": ["factualEventTitle", "timingDisplay", "expandedNarrative", "astroFooter"],
        "optional": ["editorialHeadline", "exactDateDisplay", "durationLabel", "practicalResponse", "passContext"],
        "order": ["editorialHeadline", "factualEventTitle", "timingDisplay", "expandedNarrative", "practicalResponse", "passContext", "astroFooter"],
        "constraints": ["one_coherent_situation", "astro_footer_once", "dates_outside_narrative", "no_repeated_slot_meaning"]
      }
    },
    "home_planetary_horoscope": {
      "version": "2.0.0",
      "card": {
        "required": ["factualPlacementTitle", "timingDisplay"],
        "optional": ["compactSummary"],
        "forbidden": ["expandedNarrative", "technicalFooter"]
      },
      "detail": {
        "required": ["factualPlacementTitle", "timingDisplay", "expandedNarrative"],
        "optional": ["openingClaim", "focusedQuestions", "compassionateAgency", "technicalFooter"],
        "order": ["factualPlacementTitle", "timingDisplay", "openingClaim", "expandedNarrative", "focusedQuestions", "compassionateAgency", "technicalFooter"],
        "constraints": ["resolved_rising_house_scene", "not_collective_sky", "one_subject", "questions_deepen_same_subject"]
      }
    },
    "moon_phase": {
      "version": "2.0.0",
      "detail": {
        "required": ["phaseTitle", "cycleRole", "phaseAppropriateAction"],
        "optional": ["timingDisplay"],
        "order": ["phaseTitle", "timingDisplay", "cycleRole", "phaseAppropriateAction"],
        "constraints": ["no_moon_sign_copy", "action_matches_cycle_phase"]
      }
    },
    "moon_sign": {
      "version": "2.0.0",
      "detail": {
        "required": ["signTitle", "embodiedGuidance"],
        "optional": ["timingDisplay", "boundaryOrCarePrompt"],
        "order": ["signTitle", "timingDisplay", "embodiedGuidance", "boundaryOrCarePrompt"],
        "constraints": ["short_direct_imperatives", "no_phase_copy"]
      }
    },
    "daily_horoscope": {
      "version": "2.0.0",
      "detail": {
        "required": ["dateDisplay", "editorialHeadline", "livedScenario", "proportionateSuggestion"],
        "optional": ["reflectiveTurn"],
        "order": ["dateDisplay", "editorialHeadline", "livedScenario", "reflectiveTurn", "proportionateSuggestion"],
        "constraints": ["one_daily_scene", "specific_not_generic"]
      }
    },
    "sky_planet_sign": {
      "version": "2.0.0",
      "card": {
        "required": ["factualPlacementTitle", "timingDisplay", "compactSummary"],
        "forbidden": ["expandedNarrative"]
      },
      "detail": {
        "required": ["factualPlacementTitle", "timingDisplay", "expandedNarrative"],
        "optional": ["recognizableCollectiveSituation", "proportionateResponse"],
        "order": ["factualPlacementTitle", "timingDisplay", "recognizableCollectiveSituation", "expandedNarrative", "proportionateResponse"],
        "constraints": ["collective_not_personalized", "one_collective_situation"]
      }
    },
    "sky_aspect": {
      "version": "2.0.0",
      "detail": {
        "required": ["factualEventTitle", "timingDisplay", "expandedNarrative"],
        "optional": ["exactDateDisplay", "proportionateResponse", "technicalFooter"],
        "constraints": ["exact_pair_primary", "no_planet_keyword_concatenation"]
      }
    },
    "natal_placement": {
      "version": "2.0.0",
      "detail": {
        "required": ["factualPlacementTitle", "integratedSignHouseStory"],
        "optional": ["degreeDisplay", "dignityClause", "retrogradeClause", "sectClause", "rulerBridge", "supportiveAspectClause", "challengingAspectClause"],
        "order": ["factualPlacementTitle", "degreeDisplay", "integratedSignHouseStory", "dignityClause", "retrogradeClause", "sectClause", "rulerBridge", "supportiveAspectClause", "challengingAspectClause"],
        "constraints": ["integrated_not_modular_definitions", "conditional_modifiers_only", "sect_requires_eligibility"]
      }
    },
    "natal_angle": {
      "version": "2.0.0",
      "detail": {
        "required": ["factualAngleTitle", "angleSignStory"],
        "optional": ["degreeDisplay", "rulerBridge"],
        "constraints": ["no_emergency_generic_copy"]
      }
    },
    "natal_aspect": {
      "version": "2.0.0",
      "detail": {
        "required": ["factualAspectTitle", "integratedAspectStory"],
        "optional": ["orbDisplay", "houseContext", "practicalIntegration"],
        "constraints": ["exact_pair_primary", "one_behavioral_dynamic"]
      }
    }
  }
}

