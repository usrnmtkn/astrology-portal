{
  "version": "2.0.0",
  "rule": "Resolve the product surface and intent before selecting any prose source.",
  "surfaces": [
    {
      "surface": "transits.personalized",
      "intent": "short_or_long_term_theme",
      "requiredFacts": ["transitingPoint", "aspect", "natalPoint", "activeWindow", "orb"],
      "optionalFacts": ["exactDate", "passNumber", "natalSign", "natalHouse"],
      "templateFamily": "personalized_transit",
      "primarySourcePattern": "reviewed exact aspect-pair source",
      "sourceGapWhen": "no reviewed exact aspect-pair lived-situation source"
    },
    {
      "surface": "home.planetary_horoscope",
      "intent": "current_body_sign_personalized_by_rising_house",
      "requiredFacts": ["currentBody", "currentSign", "risingSign", "resolvedWholeSignHouse", "activeWindow"],
      "optionalFacts": ["retrogradePhase", "dignity"],
      "templateFamily": "home_planetary_horoscope",
      "primarySourcePattern": "reviewed body-in-sign combination interpreted through one resolved house scene",
      "sourceGapWhen": "rising sign or reviewed combination/scene source is unavailable"
    },
    {
      "surface": "home.moon_forecast.phase",
      "intent": "lunar_cycle_phase_guidance",
      "requiredFacts": ["moonPhase", "timestamp"],
      "optionalFacts": ["lunationWindow"],
      "templateFamily": "moon_phase",
      "primarySourcePattern": "reviewed Moon-phase source",
      "sourceGapWhen": "phase source is unavailable"
    },
    {
      "surface": "home.moon_forecast.sign",
      "intent": "embodied_moon_sign_guidance",
      "requiredFacts": ["moonSign", "activeWindow"],
      "optionalFacts": ["dignity"],
      "templateFamily": "moon_sign",
      "primarySourcePattern": "reviewed Moon-in-sign source",
      "sourceGapWhen": "Moon-sign source is unavailable"
    },
    {
      "surface": "home.daily_horoscope",
      "intent": "one_daily_lived_scenario",
      "requiredFacts": ["date", "risingSign", "selectedDailyFactors"],
      "optionalFacts": ["exactAspects"],
      "templateFamily": "daily_horoscope",
      "primarySourcePattern": "reviewed daily synthesis source",
      "sourceGapWhen": "no reviewed coherent daily synthesis exists"
    },
    {
      "surface": "sky.planet_sign",
      "intent": "collective_current_sky_placement",
      "requiredFacts": ["currentBody", "currentSign", "activeWindow"],
      "optionalFacts": ["retrogradePhase", "dignity"],
      "templateFamily": "sky_planet_sign",
      "primarySourcePattern": "reviewed collective body-in-sign source",
      "sourceGapWhen": "collective combination source is unavailable"
    },
    {
      "surface": "sky.aspect",
      "intent": "collective_current_sky_aspect",
      "requiredFacts": ["pointA", "aspect", "pointB", "activeWindow", "orb"],
      "optionalFacts": ["exactDate", "applying"],
      "templateFamily": "sky_aspect",
      "primarySourcePattern": "reviewed exact current-sky aspect-pair source",
      "sourceGapWhen": "exact pair source is unavailable"
    },
    {
      "surface": "me.natal_placement",
      "intent": "integrated_natal_placement",
      "requiredFacts": ["natalBody", "natalSign", "natalHouse"],
      "optionalFacts": ["degree", "dignity", "retrograde", "sect", "rulerPlacement", "supportiveAspects", "challengingAspects"],
      "templateFamily": "natal_placement",
      "primarySourcePattern": "reviewed body-in-sign source integrated with house scene",
      "sourceGapWhen": "required placement synthesis source is unavailable"
    },
    {
      "surface": "me.natal_angle",
      "intent": "natal_angle_sign",
      "requiredFacts": ["angle", "sign"],
      "optionalFacts": ["degree", "rulerPlacement"],
      "templateFamily": "natal_angle",
      "primarySourcePattern": "reviewed angle-in-sign source",
      "sourceGapWhen": "angle source is unavailable"
    },
    {
      "surface": "me.natal_aspect",
      "intent": "integrated_natal_aspect",
      "requiredFacts": ["natalPointA", "aspect", "natalPointB", "orb"],
      "optionalFacts": ["applying", "signs", "houses"],
      "templateFamily": "natal_aspect",
      "primarySourcePattern": "reviewed exact aspect-pair source",
      "sourceGapWhen": "exact pair source is unavailable"
    }
  ]
}

