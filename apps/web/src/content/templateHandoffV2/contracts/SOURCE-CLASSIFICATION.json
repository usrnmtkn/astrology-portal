{
  "version": "2.0.0",
  "defaultTier": "EVIDENCE_ONLY",
  "readerEligibleTiers": ["REVIEWED_CLAUSE", "REVIEWED_RECORD"],
  "rules": [
    {
      "match": "cc/transit/*/house-*",
      "tier": "REFERENCE_SCAFFOLD",
      "readerEligible": false,
      "reason": "generic planet/house formula; not a lived-situation clause"
    },
    {
      "match": "cc/aspect-pair/*",
      "tier": "EVIDENCE_ONLY_UNTIL_REVIEWED",
      "readerEligible": false,
      "reason": "exact pair is the correct source family, but each extracted row still requires clause review and slot assignment"
    },
    {
      "match": "reviewed/clause/*",
      "tier": "REVIEWED_CLAUSE",
      "readerEligible": true,
      "requires": ["sourceKeys", "slot", "reviewStatus", "originalityCheck"]
    },
    {
      "match": "reviewed/record/*",
      "tier": "REVIEWED_RECORD",
      "readerEligible": true,
      "requires": ["surface", "templateId", "templateVersion", "renderedFields", "sourceKeys", "reviewStatus", "originalityCheck"]
    }
  ],
  "prohibitedSourceClasses": [
    "prompt",
    "chat_feedback",
    "status_report",
    "audit_report",
    "test_fixture_text",
    "tldr_failure_screenshot",
    "developer_diagnostic",
    "raw_chani_copy"
  ]
}

