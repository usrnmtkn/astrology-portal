# Optional path to Swiss Ephemeris data files.
# In production, mount licensed ephemeris files outside git and point this
# variable at that mounted directory.
TLDR_ASTRO_EPHEMERIS_PATH=

# Comma-separated browser origins allowed to call this API.
# Production example:
# TLDR_ASTRO_ALLOWED_ORIGINS=https://tldrastro.vercel.app,https://www.tldrastro.com
TLDR_ASTRO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
